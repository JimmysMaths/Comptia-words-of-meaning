/* ============================================================
   STATE + FLASHCARD ENGINE
   ============================================================ */
let currentTopic = null, currentCards = [], currentIndex = 0, revealed = false;
let scores = { correct: 0, wrong: 0, skip: 0 };
let topicScores = {};

const STATION_NAMES = {
  1: "Category 1",
};

function buildTopicGrid() {
  const grid = document.getElementById('topic-grid');
  let lastStation = null;
  TOPICS.slice().sort((a, b) => a.station - b.station).forEach(t => {
    if (t.station !== lastStation) {
      const lbl = document.createElement('div');
      lbl.className = 'station-group-label';
      lbl.style.gridColumn = '1 / -1';
      lbl.textContent = STATION_NAMES[t.station];
      grid.appendChild(lbl);
      lastStation = t.station;
    }
    const btn = document.createElement('button');
    btn.className = 'topic-btn'; btn.id = 'topic-' + t.id;
    btn.innerHTML = '<span class="reg-tag">' + t.reg + '</span>' + t.name + '<span class="count-tag">' + t.cards.length + '</span>';
    btn.onclick = () => selectTopic(t.id);
    grid.appendChild(btn);
  });
}
function selectTopic(id) {
  currentTopic = TOPICS.find(t => t.id === id);
  currentCards = shuffle(currentTopic.cards.slice());
  currentIndex = 0; revealed = false;
  document.querySelectorAll('.topic-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('topic-' + id).classList.add('active');
  document.getElementById('current-topic-tag').textContent = currentTopic.reg + ' — ' + currentTopic.name.toUpperCase();
  if (!topicScores[id]) topicScores[id] = { correct: 0, wrong: 0 };
  loadCard();
  scrollToCard();
}
function shuffle(arr) {
  for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [arr[i], arr[j]] = [arr[j], arr[i]]; }
  return arr;
}
function loadCard() {
  if (!currentTopic || currentCards.length === 0) return;
  const card = currentCards[currentIndex % currentCards.length];
  revealed = false;
  document.getElementById('main-card').className = 'card';
  document.getElementById('card-topic').textContent = currentTopic.reg + ' — ' + currentTopic.name;
  document.getElementById('card-q').textContent = card.q;
  document.getElementById('card-a').innerHTML = card.a;
  document.getElementById('card-a').classList.remove('show');
  document.getElementById('reveal-btn').disabled = false;
  document.getElementById('skip-btn').disabled = false;
  document.getElementById('reveal-row').style.display = 'flex';
  document.getElementById('judge-row').style.display = 'none';
  document.getElementById('next-row').style.display = 'none';
  document.getElementById('deck-label').textContent = 'Answer out loud, then reveal';
  const total = currentCards.length;
  document.getElementById('progress-bar').style.width = ((currentIndex % total) / total) * 100 + '%';
}
function revealAnswer() {
  revealed = true;
  document.getElementById('card-a').classList.add('show');
  document.getElementById('main-card').classList.add('revealed');
  document.getElementById('reveal-row').style.display = 'none';
  document.getElementById('judge-row').style.display = 'flex';
  document.getElementById('next-row').style.display = 'flex';
  document.getElementById('deck-label').textContent = 'Score yourself honestly';
}
function markCard(result) {
  const card = document.getElementById('main-card');
  if (result === 'correct') { scores.correct++; card.classList.remove('revealed'); card.classList.add('correct-card'); if (currentTopic) topicScores[currentTopic.id].correct++; }
  else { scores.wrong++; card.classList.remove('revealed'); card.classList.add('wrong-card'); if (currentTopic) topicScores[currentTopic.id].wrong++; }
  updateScores(); updateWeakTopics();
  document.getElementById('judge-row').style.display = 'none';
  document.getElementById('deck-label').textContent = result === 'correct' ? 'Marked correct' : 'Marked missed — this topic goes in weak areas';
}

/* Scroll the card into view under the sticky topbar */
function scrollToCard() {
  const target = document.querySelector('.card-container');
  const bar = document.querySelector('.topbar');
  if (!target) return;
  target.style.scrollMarginTop = ((bar ? bar.offsetHeight : 100) + 14) + 'px';
  target.scrollIntoView({ behavior: 'smooth', block: 'start' });
}
function skipCard() { scores.skip++; updateScores(); nextCard(); }
function nextCard() {
  currentIndex++;
  if (currentIndex >= currentCards.length) { currentCards = shuffle(currentTopic.cards.slice()); currentIndex = 0; }
  loadCard();
}
function updateScores() {
  document.getElementById('score-correct').textContent = scores.correct;
  document.getElementById('score-wrong').textContent = scores.wrong;
  document.getElementById('score-skip').textContent = scores.skip;
}
function resetScores() {
  scores = { correct: 0, wrong: 0, skip: 0 }; topicScores = {};
  updateScores(); updateWeakTopics();
  if (currentTopic) selectTopic(currentTopic.id);
}
function updateWeakTopics() {
  const weak = [];
  for (const id in topicScores) {
    const s = topicScores[id]; const total = s.correct + s.wrong;
    if (total >= 3 && s.wrong / total > 0.4) {
      const topic = TOPICS.find(t => t.id === id);
      weak.push(topic.name + ' (' + s.wrong + 'W / ' + s.correct + 'C)');
    }
  }
  const section = document.getElementById('weak-section');
  const list = document.getElementById('weak-list');
  if (weak.length > 0) { section.style.display = 'block'; list.innerHTML = weak.join('<br>'); }
  else { section.style.display = 'none'; }
}

/* ---------- Hamburger menu + view switching ---------- */
const VIEW_LABELS = {
  flashcards: 'FLASHCARDS',
  guide: 'STUDY GUIDE'
};
const drawer = document.getElementById('nav-drawer');
const burger = document.getElementById('hamburger');

function setDrawer(open) {
  drawer.classList.toggle('open', open);
  burger.classList.toggle('open', open);
  burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
}
burger.onclick = () => setDrawer(!drawer.classList.contains('open'));

function switchView(view) {
  document.querySelectorAll('.nav-item').forEach(t => t.classList.toggle('active', t.dataset.view === view));
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById('view-' + view).classList.add('active');
  document.getElementById('score-bar').style.display = (view === 'flashcards') ? 'flex' : 'none';
  document.getElementById('current-view-tag').textContent = VIEW_LABELS[view] || '';
  setDrawer(false);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
document.querySelectorAll('.nav-item').forEach(t => t.onclick = () => switchView(t.dataset.view));

/* Close the drawer on Escape or on a tap outside it */
document.addEventListener('keydown', e => { if (e.key === 'Escape') setDrawer(false); });
document.addEventListener('click', e => {
  if (drawer.classList.contains('open') && !drawer.contains(e.target) && !burger.contains(e.target)) setDrawer(false);
});

/* ---------- Date stamp ---------- */
function setDate() {
  const d = new Date();
  const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
  const stamp = String(d.getDate()).padStart(2, '0') + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
  document.getElementById('date-tag').innerHTML = 'LAST UPDATED: ' + stamp + '<br>TARGET DATE: SET YOUR OWN';
}
